---
const { data, lang } = Astro.props;
---

<section class="relative min-h-[60vh] py-10 md:py-16 px-6 md:px-12 lg:px-24 max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center gap-12 overflow-hidden">
  <div class="flex-1 space-y-6 relative z-10">
    <div class="flex items-center gap-2 text-sm font-bold text-secondary">
      <span class="w-2.5 h-2.5 rounded-full bg-primary inline-block animate-ping"></span>
      {data.tagline[lang]} 
      <span class="text-primary ml-2 flex items-center gap-1.5 bg-primary/10 px-2.5 py-1 rounded-full text-xs">
        <span class="w-2 h-2 rounded-full bg-primary inline-block animate-pulse"></span> Live
      </span>
    </div>
    
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-black font-display leading-[1.15] text-onSurface" set:html={data.title[lang]}>
    </h1>
    
    <p class="text-onSurfaceVariant text-base md:text-lg leading-relaxed max-w-xl">
      {data.description[lang]}
    </p>
    
    <div class="flex flex-wrap items-center gap-4 pt-4">
      <a class="bg-primary hover:bg-green-500 text-white font-bold py-3.5 px-8 rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 active:translate-y-0 text-sm md:text-base" href={data.cta1_link}>
        {data.cta1_label[lang]}
      </a>
      <a class="bg-white border-2 border-gray-200 hover:border-primary hover:text-primary text-onSurface font-bold py-3.5 px-8 rounded-full transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 text-sm md:text-base" href={data.cta2_link}>
        {data.cta2_label[lang]}
      </a>
    </div>
  </div>
  
  <div class="flex-1 relative w-full group">
    <!-- Abstract Decoration matching wireframe but elevated -->
    <div class="absolute -top-6 -right-6 w-48 h-48 bg-secondary/15 rounded-full blur-3xl z-0 animate-pulse"></div>
    <div class="absolute -bottom-6 -left-6 w-48 h-48 bg-primary/15 rounded-full blur-3xl z-0 animate-pulse delay-1000"></div>
    
    <!-- Decorative border framework -->
    <div class="absolute -top-3 -right-3 w-16 h-16 border-t-4 border-r-4 border-secondary rounded-tr-2xl z-0 transition-all duration-300 group-hover:-top-4 group-hover:-right-4"></div>
    <div class="absolute -bottom-3 -left-3 w-16 h-16 border-b-4 border-l-4 border-primary rounded-bl-2xl z-0 transition-all duration-300 group-hover:-bottom-4 group-hover:-left-4"></div>
    
    <!-- Hero Image Placeholder -->
    <img 
      alt="Hero Image" 
      class="w-full h-[350px] md:h-[400px] object-cover relative z-10 rounded-2xl shadow-xl border border-gray-100/50 transform transition-all duration-500 group-hover:scale-[1.02] group-hover:shadow-2xl" 
      src={data.image?.secure_url}
    />
  </div>
  
  <!-- Scroll indicator -->
  <div class="fixed bottom-6 left-1/2 -translate-x-1/2 hidden md:flex items-center justify-center z-50 pointer-events-none">
    <svg class="h-8 w-8 text-gray-300 animate-bounce pointer-events-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M19 14l-7 7m0 0l-7-7m7 7V3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
    </svg>
  </div>
</section>
