---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Hero Section -->
<section class="relative px-6 py-12 md:py-24 max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 space-y-8 z-10">
        <span
            class="inline-block px-4 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant text-sm font-bold uppercase tracking-widest">{t('hero.tagline')}</span>
        <h1
            class="text-5xl md:text-7xl font-black font-headline text-on-surface leading-[0.95] tracking-tighter">
            {t('hero.title').split(t('hero.title_passion'))[0]}<span class="text-primary italic">{t('hero.title_passion')}</span>{t('hero.title').split(t('hero.title_passion'))[1]}
        </h1>
        <p class="text-lg md:text-xl text-on-surface-variant max-w-xl leading-relaxed">
            {t('hero.description')}
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
            <button
                class="px-8 py-4 bg-secondary-container text-on-secondary-container rounded-full font-headline font-black text-lg transition-all duration-300 hover:scale-105 shadow-xl shadow-secondary/10">
                {t('hero.view_programs')}
            </button>
            <button
                class="px-8 py-4 border-2 border-outline-variant/30 rounded-full font-headline font-bold text-lg hover:bg-surface-container-low transition-all duration-300">
                {t('hero.our_story')}
            </button>
        </div>
    </div>
    <div class="flex-1 relative">
        <div class="absolute inset-0 bg-primary/10 blob-mask -rotate-12 scale-110"></div>
        <div class="relative z-10 blob-mask overflow-hidden aspect-square shadow-2xl">
            <img alt="Child learning" class="w-full h-full object-cover"
                data-alt="cheerful young boy wearing headphones using a tablet with a glowing screen in a modern colorful technology classroom"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCZX7NVba9W63pOek_LHI5IvjHdc9w2CnDX4MCXywE2S4WPLpfaIdRlexUt7UhWnJ3BtaH2_ql3WGCP0bcz-99ffGmuxTMz6yL62KMd20IlCqR7xEAzWyRdIRz8vOzlnhWx_GHWooweS-IoxPl_n2J5iUJbZ98vyzBdFDGVVmp1aIpaELUSE3buXobTmHqgrXDXq0UVL9LXhF47mjnLRQoQsWNaJdfxkoyQ0iZOg5OTbfJDG6lV-afsJQsU2IpdnPdsADTN7KEIpg" />
        </div>
        <!-- Floating Element -->
        <div
            class="absolute -bottom-6 -left-6 md:-left-12 bg-white/90 backdrop-blur-md p-6 rounded-xl shadow-2xl border border-white/20 hidden sm:block">
            <div class="flex items-center gap-4">
                <div
                    class="w-12 h-12 bg-tertiary-container rounded-full flex items-center justify-center text-on-tertiary-container">
                    <span class="material-symbols-outlined" data-weight="fill">robot_2</span>
                </div>
                <div>
                    <p class="font-headline font-black text-on-surface leading-none">{t('hero.robots')}</p>
                    <p class="text-xs text-on-surface-variant font-bold uppercase tracking-tight">{t('hero.robots_sub')}</p>
                </div>
            </div>
        </div>
    </div>
</section>
