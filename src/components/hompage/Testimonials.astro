---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-onSurface font-display">
        {lang === 'vi' ? 'Phụ Huynh Nói Gì Về Chúng Tôi' : 'What Parents Say About Us'}
      </h2>
      <p class="text-onSurfaceVariant text-sm md:text-base max-w-xl mx-auto">
        {lang === 'vi' 
          ? 'Ý kiến chia sẻ thực tế từ các gia đình có con em đang theo học tại Little Da Vinci.' 
          : 'Real feedback from parents whose kids are learning and building at Little Da Vinci.'}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {data.items.map((item: any, index: number) => (
        <div class={`bg-surface border border-gray-100/60 rounded-3xl p-8 flex flex-col justify-between shadow-sm relative transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${index === 1 ? 'ring-2 ring-primary border-transparent' : ''}`}>
          
          <!-- Quote Icon decoration -->
          <span class="material-symbols-outlined absolute top-6 right-8 text-5xl text-primary/10 select-none">format_quote</span>
          
          <div class="flex gap-0.5 text-amber-400 mb-6">
            {[...Array(5)].map(() => (
              <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
            ))}
          </div>
          
          <p class="text-sm md:text-base text-onSurfaceVariant leading-relaxed mb-6 flex-1 italic">
            "{item.content[lang]}"
          </p>
          
          <div class="flex items-center gap-3 pt-4 border-t border-gray-100/60">
            <div class={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm text-white shrink-0 ${index % 3 === 0 ? 'bg-primary' : index % 3 === 1 ? 'bg-secondary' : 'bg-amber-500'}`}>
              {item.author[lang].replace(/^(Anh|Chị|Mrs\.|Mr\.)\s+/, '').charAt(0) || 'P'}
            </div>
            <div class="text-left">
              <p class="font-bold text-xs md:text-sm text-onSurface leading-snug">{item.author[lang]}</p>
              <p class="text-[10px] text-onSurfaceVariant font-semibold">{lang === 'vi' ? 'Phụ huynh học viên' : 'Parent'}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
