---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Language switching calculations
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname;
let relativePath = pathname;
if (base && pathname.startsWith(base)) {
  relativePath = pathname.substring(base.length);
}
if (!relativePath.startsWith('/')) {
  relativePath = '/' + relativePath;
}

const isEnglish = relativePath.startsWith('/en/') || relativePath === '/en';
let viPath = relativePath;
let enPath = relativePath;

if (isEnglish) {
  viPath = relativePath.replace(/^\/en/, '') || '/';
} else {
  enPath = `/en${relativePath === '/' ? '' : relativePath}`;
}

const viHref = `${base}${viPath}`;
const enHref = `${base}${enPath}`;

const navLinks = [
  { href: translatePath('/courses'), label: { vi: 'Khóa Học', en: 'Courses' }, icon: 'school' },
  { href: translatePath('/teams'), label: { vi: 'Đội Ngũ', en: 'Team' }, icon: 'groups' },
  { href: translatePath('/events'), label: { vi: 'Sự Kiện', en: 'Events' }, icon: 'event' },
  { href: translatePath('/contact'), label: { vi: 'Liên Hệ', en: 'Contact' }, icon: 'mail' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<header class="w-full bg-white/80 backdrop-blur-lg py-3 border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 w-full flex items-center justify-between">
    <!-- Brand Logo -->
    <a class="flex items-center gap-2 hover:opacity-90 transition-opacity" href={translatePath('/')}>
      <div class="w-12 h-12 bg-gray-200 rounded flex items-center justify-center text-xs font-bold text-gray-500">
        <svg class="h-8 w-8 text-primary" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"></path>
        </svg>
      </div>
      <span class="font-bold text-lg leading-tight uppercase text-onSurface">Little<br/>Da Vinci</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 font-medium text-sm">
      <a class={`px-3 py-2 rounded-full transition-all duration-200 ${currentPath === translatePath('/').replace(/\/$/, '') ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-gray-50 hover:text-primary'}`} href={translatePath('/')}>
        {lang === 'vi' ? 'Trang Chủ' : 'Home'}
      </a>
      {navLinks.map(link => (
        <a class={`px-3 py-2 rounded-full transition-all duration-200 flex items-center gap-1 ${currentPath === link.href.replace(/\/$/, '') ? 'bg-primary/10 text-primary font-bold' : 'hover:bg-gray-50 hover:text-primary'}`} href={link.href}>
          {link.label[lang]}
        </a>
      ))}
    </nav>

    <!-- CTAs and Lang Switcher -->
    <div class="hidden md:flex items-center gap-3">
      <a class="bg-primary hover:bg-green-500 text-white font-semibold py-2.5 px-6 rounded-full text-sm transition-colors shadow-sm hover:shadow-md" href={translatePath('/contact')}>
        {t('nav.book')}
      </a>

      <!-- Language Selector -->
      <div class="flex items-center gap-1 bg-gray-50 p-1 rounded-full border border-gray-100">
        <a href={viHref} class={`text-xs px-2.5 py-1.5 rounded-full font-bold transition-all ${!isEnglish ? 'bg-primary text-white shadow-sm' : 'text-gray-500 hover:text-primary'}`}>
          VI
        </a>
        <a href={enHref} class={`text-xs px-2.5 py-1.5 rounded-full font-bold transition-all ${isEnglish ? 'bg-primary text-white shadow-sm' : 'text-gray-500 hover:text-primary'}`}>
          EN
        </a>
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" class="md:hidden p-2 text-onSurface focus:outline-none" aria-label="Toggle Menu">
      <span class="material-symbols-outlined text-2xl" id="menu-icon">menu</span>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-drawer" class="fixed inset-0 bg-white z-40 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col pt-24 px-6 gap-6">
  <div class="flex flex-col gap-2 overflow-y-auto max-h-[70vh]">
    <a href={translatePath('/')} class={`text-base font-bold py-3 px-4 rounded-xl transition-all ${currentPath === translatePath('/').replace(/\/$/, '') ? 'bg-primary/10 text-primary' : 'text-onSurface hover:bg-gray-50'}`}>
      <span class="flex items-center gap-3">
        <span class="material-symbols-outlined text-xl">home</span>
        {lang === 'vi' ? 'Trang Chủ' : 'Home'}
      </span>
    </a>

    {navLinks.map(link => (
      <a href={link.href} class={`text-base font-bold py-3 px-4 rounded-xl transition-all ${currentPath === link.href.replace(/\/$/, '') ? 'bg-primary/10 text-primary' : 'text-onSurface hover:bg-gray-50'}`}>
        <span class="flex items-center gap-3">
          <span class="material-symbols-outlined text-xl">{link.icon}</span>
          {link.label[lang]}
        </span>
      </a>
    ))}
  </div>

  <div class="mt-auto pb-8 flex flex-col gap-4 border-t border-gray-100 pt-4">
    <!-- Language Switcher for Mobile -->
    <div class="flex items-center gap-4 justify-center bg-gray-50 p-1 rounded-full border border-gray-100">
      <a href={viHref} class={`text-sm flex-1 text-center py-2 rounded-full font-bold ${!isEnglish ? 'bg-primary text-white shadow-sm' : 'text-gray-500'}`}>Tiếng Việt</a>
      <a href={enHref} class={`text-sm flex-1 text-center py-2 rounded-full font-bold ${isEnglish ? 'bg-primary text-white shadow-sm' : 'text-gray-500'}`}>English</a>
    </div>
    <a class="bg-primary hover:bg-green-500 text-white font-semibold py-3 px-6 rounded-full text-center text-sm shadow-sm" href={translatePath('/contact')}>
      {t('nav.book')}
    </a>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const menuIcon = document.getElementById('menu-icon');

  if (toggleBtn && drawer && menuIcon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('translate-x-0');
      if (isOpen) {
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        menuIcon.textContent = 'menu';
      } else {
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        menuIcon.textContent = 'close';
      }
    });
  }
</script>
