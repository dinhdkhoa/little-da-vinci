---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import homeData from '../../content/home.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const cta = homeData.cta;
---

<footer class="bg-black text-white py-12 border-t border-gray-900">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start mb-8 pb-8 border-b border-gray-800">
      <!-- Brand & Description -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-10 h-10 bg-gray-800 rounded flex items-center justify-center text-xs font-bold text-gray-500">
            <svg class="h-6 w-6 text-primary" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"></path>
            </svg>
          </div>
          <div>
            <span class="font-bold text-sm leading-tight block">Little Da Vinci</span>
            <span class="text-xs text-gray-400">Tech Academy</span>
          </div>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed max-w-sm">
          {lang === 'vi' 
            ? 'Ươm mầm tư duy công nghệ thế hệ mới. Học thông qua sáng tạo trực quan sinh động.' 
            : 'Igniting technology passion for the next generation. Learning through playful visualization.'}
        </p>
      </div>

      <!-- Links Grid -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-gray-200 uppercase tracking-wider">{lang === 'vi' ? 'Liên kết nhanh' : 'Quick Links'}</h4>
        <nav class="flex flex-col gap-2 text-sm text-gray-400">
          <a class="hover:text-primary transition-colors" href={translatePath('/')}>
            {lang === 'vi' ? 'Trang Chủ' : 'Home'}
          </a>
          <a class="hover:text-primary transition-colors" href={translatePath('/courses')}>
            {lang === 'vi' ? 'Khóa Học' : 'Courses'}
          </a>
          <a class="hover:text-primary transition-colors" href={translatePath('/teams')}>
            {lang === 'vi' ? 'Đội Ngũ' : 'Team'}
          </a>
          <a class="hover:text-primary transition-colors" href={translatePath('/events')}>
            {lang === 'vi' ? 'Sự Kiện' : 'Events'}
          </a>
          <a class="hover:text-primary transition-colors" href={translatePath('/contact')}>
            {lang === 'vi' ? 'Liên Hệ' : 'Contact'}
          </a>
        </nav>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4 text-xs text-gray-400">
        <h4 class="text-sm font-bold text-gray-200 uppercase tracking-wider">{lang === 'vi' ? 'Thông tin liên hệ' : 'Contact'}</h4>
        <div class="flex items-start gap-2">
          <span class="material-symbols-outlined text-sm text-primary mt-0.5">location_on</span>
          <span>{cta.address[lang]}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-primary">mail</span>
          <a href={`mailto:${cta.email[lang]}`} class="hover:text-primary transition-colors">{cta.email[lang]}</a>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-primary">call</span>
          <a href={`tel:${cta.phone[lang]}`} class="hover:text-primary transition-colors">{cta.phone[lang]}</a>
        </div>
      </div>
    </div>
    
    <div class="text-xs text-gray-500 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-4">
      <span>Little Da Vinci © 2026 | {lang === 'vi' ? 'Bảo lưu mọi quyền' : 'All rights reserved.'}</span>
      <a class="hover:text-primary transition-colors font-medium text-gray-400" href="/keystatic">Keystatic CMS Admin</a>
    </div>
  </div>
</footer>
