---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-2">{data.title[lang]}</h2>
      <p class="text-onSurfaceVariant italic">{data.quote[lang]}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.courses.map((course: any, index: number) => (
        <div class={`bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col ${index === 1 ? 'shadow-md border-2 border-primary transform md:-translate-y-2 transition-transform' : ''}`}>
          <div class="h-48 relative">
            <img alt={course.title[lang]} class="w-full h-full object-cover" src={course.image?.secure_url}/>
            <span class="absolute bottom-4 right-4 bg-primary text-white text-xs font-bold py-1 px-3 rounded-full">{course.ageRange[lang]}</span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="font-bold text-lg mb-2 uppercase">{course.title[lang]}</h3>
            <p class="text-sm text-onSurfaceVariant mb-4 flex-1">{course.description[lang]}</p>
            <div class="flex items-center gap-2 text-xs font-medium">
              {course.tags.map((tag: any, i: number) => (
                <>
                  <span class="">{tag[lang]}</span>
                  {i < course.tags.length - 1 && <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>}
                </>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
