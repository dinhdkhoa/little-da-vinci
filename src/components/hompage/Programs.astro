---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-onSurface">{data.title[lang]}</h2>
      <p class="text-onSurfaceVariant italic text-sm md:text-base max-w-xl mx-auto">{data.quote[lang]}</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.courses.map((course: any, index: number) => (
        <div class={`group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl hover:-translate-y-2 border border-gray-100 transition-all duration-300 flex flex-col ${index === 1 ? 'shadow-md ring-2 ring-primary border-transparent' : ''}`}>
          
          {index === 1 && (
            <span class="absolute top-3 left-3 bg-secondary text-white text-[10px] font-black tracking-widest uppercase py-1.5 px-3 rounded-md z-20 shadow-sm">
              {lang === 'vi' ? 'Yêu Thích' : 'Popular'}
            </span>
          )}

          <div class="h-48 relative overflow-hidden">
            <img 
              alt={course.title[lang]} 
              class="w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-105" 
              src={course.image?.secure_url}
            />
            <span class="absolute bottom-4 right-4 bg-primary text-white text-xs font-bold py-1 px-3 rounded-full shadow-sm">{course.ageRange[lang]}</span>
          </div>
          
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="font-bold text-lg mb-2 text-onSurface uppercase tracking-tight group-hover:text-primary transition-colors duration-300">
              {course.title[lang]}
            </h3>
            <p class="text-sm text-onSurfaceVariant mb-6 flex-1 leading-relaxed">
              {course.description[lang]}
            </p>
            
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
              <div class="flex flex-wrap items-center gap-1.5">
                {course.tags.map((tag: any) => (
                  <span class="text-[9px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded bg-gray-150 text-onSurfaceVariant">
                    {tag[lang]}
                  </span>
                ))}
              </div>
              <a href="#register" class="text-xs font-bold text-secondary group-hover:text-primary flex items-center gap-0.5 transition-colors">
                {lang === 'vi' ? 'Đăng ký' : 'Enrol'}
                <span class="material-symbols-outlined text-sm font-bold transition-transform group-hover:translate-x-0.5">chevron_right</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
