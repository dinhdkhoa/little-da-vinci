---
const { data, lang } = Astro.props;
---

<!-- Why Choose Us -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-onSurface">{data.title[lang]}</h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {data.features.map((feature: any, index: number) => (
        <div class="flex flex-col items-center text-center space-y-4 p-8 rounded-3xl hover:bg-surface border border-gray-100/50 hover:border-primary/20 transition-all duration-300 hover:shadow-xl group hover:-translate-y-1">
          <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mb-2 shadow-sm transition-transform duration-300 group-hover:scale-110 ${index === 0 ? 'bg-primary/10 text-primary' : index === 1 ? 'bg-secondary/10 text-secondary' : 'bg-amber-50 text-amber-500'}`}>
            <span class="material-symbols-outlined text-3xl">{feature.icon}</span>
          </div>
          <h3 class="text-xl font-bold text-onSurface">{feature.title[lang]}</h3>
          <p class="text-sm text-onSurfaceVariant leading-relaxed">{feature.description[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
