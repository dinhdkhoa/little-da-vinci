---
import { getLangFromUrl } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
---

<section class="py-16 bg-surface border-t border-b border-gray-100/50">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <h2 class="text-xs font-black uppercase tracking-widest text-center text-onSurfaceVariant mb-10">
      {lang === 'vi' ? 'Công nghệ & Đối tác đồng hành' : 'Technology & Academic Partners'}
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-8 opacity-80">
      <!-- Scratch Logo -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
        <span class="font-black text-sm text-gray-700 tracking-tight">SCRATCH</span>
      </div>
      <!-- Minecraft -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-green-600"></span>
        <span class="font-extrabold text-sm text-gray-800 tracking-tight">MINECRAFT</span>
      </div>
      <!-- Microbit -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
        <span class="font-bold text-sm text-gray-700 tracking-tight">micro:bit</span>
      </div>
      <!-- Python -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        <span class="font-semibold text-sm text-gray-700 tracking-tight">Python</span>
      </div>
      <!-- Arduino -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-600"></span>
        <span class="font-bold text-sm text-gray-700 tracking-tight">Arduino</span>
      </div>
      <!-- React -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>
        <span class="font-semibold text-sm text-gray-700 tracking-tight">React JS</span>
      </div>
      <!-- Astro -->
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-105 select-none">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-650"></span>
        <span class="font-black text-sm text-gray-700 tracking-tight">Astro</span>
      </div>
    </div>
  </div>
</section>
