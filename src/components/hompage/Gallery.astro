---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-secondary">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-white">{data.title[lang]}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-auto md:h-[500px]">
      <!-- Large Left Image -->
      <div class="rounded-xl h-64 md:h-full overflow-hidden col-span-1 shadow-lg">
        <img alt="Gallery Image 1" class="w-full h-full object-cover" src={data.images[0]?.secure_url}/>
      </div>
      <!-- Stacked Center Images -->
      <div class="flex flex-col gap-6 col-span-1 md:h-full">
        <div class="rounded-xl h-48 md:flex-1 md:min-h-0 overflow-hidden shadow-lg">
          <img alt="Gallery Image 2" class="w-full h-full object-cover" src={data.images[1]?.secure_url}/>
        </div>
        <div class="rounded-xl h-48 md:flex-1 md:min-h-0 overflow-hidden shadow-lg">
          <img alt="Gallery Image 3" class="w-full h-full object-cover" src={data.images[2]?.secure_url}/>
        </div>
      </div>
      <!-- Large Right Image -->
      <div class="rounded-xl h-64 md:h-full overflow-hidden col-span-1 shadow-lg">
        <img alt="Gallery Image 4" class="w-full h-full object-cover" src={data.images[3]?.secure_url}/>
      </div>
    </div>
    <div class="mt-32 h-64 md:h-80 rounded-xl overflow-hidden shadow-lg">
      <img alt="Gallery Image 5" class="w-full h-full object-cover" src={data.images[4]?.secure_url}/>
    </div>
  </div>
</section>
