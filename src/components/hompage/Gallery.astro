---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-secondary relative overflow-hidden">
  <!-- Glowing abstract light background details -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 relative z-10">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-white font-display">{data.title[lang]}</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4 h-auto md:h-[600px]">
      <!-- Image 1 (Large left) -->
      <div class="rounded-2xl h-64 md:h-full overflow-hidden md:col-span-2 md:row-span-2 shadow-lg group relative border border-white/10">
        <img alt="Gallery Image 1" class="w-full h-full object-cover transform transition-transform duration-750 group-hover:scale-105" src={data.images[0]?.secure_url} loading="lazy" />
        <div class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-all duration-300"></div>
      </div>
      <!-- Image 2 (Top center) -->
      <div class="rounded-2xl h-48 md:h-full overflow-hidden md:col-span-1 md:row-span-1 shadow-lg group relative border border-white/10">
        <img alt="Gallery Image 2" class="w-full h-full object-cover transform transition-transform duration-750 group-hover:scale-105" src={data.images[1]?.secure_url} loading="lazy" />
        <div class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-all duration-300"></div>
      </div>
      <!-- Image 3 (Top right) -->
      <div class="rounded-2xl h-48 md:h-full overflow-hidden md:col-span-1 md:row-span-1 shadow-lg group relative border border-white/10">
        <img alt="Gallery Image 3" class="w-full h-full object-cover transform transition-transform duration-750 group-hover:scale-105" src={data.images[2]?.secure_url} loading="lazy" />
        <div class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-all duration-300"></div>
      </div>
      <!-- Image 4 (Bottom center) -->
      <div class="rounded-2xl h-48 md:h-full overflow-hidden md:col-span-1 md:row-span-1 shadow-lg group relative border border-white/10">
        <img alt="Gallery Image 4" class="w-full h-full object-cover transform transition-transform duration-750 group-hover:scale-105" src={data.images[3]?.secure_url} loading="lazy" />
        <div class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-all duration-300"></div>
      </div>
      <!-- Image 5 (Bottom right) -->
      <div class="rounded-2xl h-48 md:h-full overflow-hidden md:col-span-1 md:row-span-1 shadow-lg group relative border border-white/10">
        <img alt="Gallery Image 5" class="w-full h-full object-cover transform transition-transform duration-750 group-hover:scale-105" src={data.images[4]?.secure_url} loading="lazy" />
        <div class="absolute inset-0 bg-black/15 group-hover:bg-black/0 transition-all duration-300"></div>
      </div>
    </div>
  </div>
</section>
