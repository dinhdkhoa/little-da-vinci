---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    <div class="text-right mb-16 max-w-2xl ml-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-onSurface">{data.title[lang]}</h2>
      <p class="text-onSurfaceVariant text-base leading-relaxed">
        {data.description[lang]}
      </p>
    </div>
    
    <!-- Node Diagram Representation -->
    <div class="relative w-full py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
        <!-- Connecting Line between steps -->
        <div class="hidden md:block absolute top-10 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-primary via-indigo-400 to-secondary z-0 opacity-40"></div>
        
        {data.steps.map((step: any, index: number) => (
          <div class="relative flex flex-col items-center text-center group z-10">
            <div class={`w-20 h-20 rounded-full flex items-center justify-center text-white mb-6 shadow-md border-4 border-white relative transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:rotate-6 ${index % 2 === 0 ? 'bg-primary shadow-primary/20' : 'bg-secondary shadow-secondary/20'}`}>
              <span class="material-symbols-outlined text-3.5xl">{step.icon}</span>
              <div class={`absolute -top-1.5 -right-1.5 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white shadow-sm border-2 border-white ${index % 2 === 0 ? 'bg-secondary' : 'bg-primary'}`}>{index + 1}</div>
            </div>
            <h3 class="font-bold text-lg text-onSurface mb-2 group-hover:text-primary transition-colors duration-300">{step.title[lang]}</h3>
            <p class="text-sm text-onSurfaceVariant leading-relaxed px-4">{step.description[lang]}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
