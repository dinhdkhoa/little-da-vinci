---
const { data, lang } = Astro.props;
---

<section class="py-20 bg-surface" id="register">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 flex flex-col md:flex-row gap-16">
    <!-- Contact Info -->
    <div class="flex-1 space-y-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{data.title[lang]}</h2>
        <p class="text-onSurfaceVariant">{data.description[lang]}</p>
      </div>
      <ul class="space-y-6 text-sm text-onSurfaceVariant">
        <li class="flex items-start gap-4">
          <svg class="h-6 w-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <span class="">{data.address[lang]}</span>
        </li>
        <li class="flex items-start gap-4">
          <svg class="h-6 w-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <span class="">{data.email[lang]}</span>
        </li>
        <li class="flex items-start gap-4">
          <svg class="h-6 w-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
          <span class="">{data.phone[lang]}</span>
        </li>
      </ul>
    </div>
    <!-- Form Card -->
    <div class="flex-1">
      <div class="bg-white p-8 rounded-xl border-2 border-primary shadow-sm relative">
        <form action="#" class="space-y-4" method="POST">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1" for="name">Họ Tên</label>
              <input class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50 text-sm py-2 px-3" id="name" name="name" type="text"/>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1" for="phone">Số Điện Thoại</label>
              <input class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50 text-sm py-2 px-3 placeholder-gray-400" id="phone" name="phone" placeholder="(+84) 000-000-0000" type="tel"/>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1" for="target">Đối Tượng Đăng Ký</label>
            <input class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50 text-sm py-2 px-3 placeholder-gray-400" id="target" name="target" placeholder="eg: Con" type="text"/>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1" for="interest">Interest</label>
              <input class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50 text-sm py-2 px-3 placeholder-gray-400" id="interest" name="interest" placeholder="eg: Robotic" type="text"/>
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-gray-700 mb-1" for="message">Message</label>
              <textarea class="w-full border-gray-300 rounded-md shadow-sm focus:border-primary focus:ring focus:ring-primary focus:ring-opacity-50 text-sm py-2 px-3 placeholder-gray-400" id="message" name="message" placeholder="Hãy chia sẻ với chúng tôi một chút vì sao bạn lại tìm tới Little Da Vinci..." rows="4"></textarea>
            </div>
          </div>
          <div class="pt-2 text-right">
            <button class="w-full md:w-auto bg-secondary hover:bg-blue-700 text-white font-semibold py-2.5 px-8 rounded-md transition-colors text-sm" type="submit">
              Đăng Ký
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
