---
const { data, lang } = Astro.props;

const labels = {
  vi: {
    fullName: "Họ Tên Phụ Huynh",
    fullNamePlaceholder: "Nguyễn Văn A",
    phone: "Số Điện Thoại",
    phonePlaceholder: "(+84) 000-000-000",
    target: "Tên & Tuổi Của Bé",
    targetPlaceholder: "Ví dụ: Nguyễn Minh Đức - 8 tuổi",
    interest: "Khóa Học Quan Tâm",
    interestPlaceholder: "Ví dụ: Lập trình Scratch",
    message: "Lời Nhắn",
    messagePlaceholder: "Hãy chia sẻ mong muốn hoặc thắc mắc của bạn với chúng tôi...",
    submit: "Đăng Ký Ngay"
  },
  en: {
    fullName: "Parent's Full Name",
    fullNamePlaceholder: "John Doe",
    phone: "Phone Number",
    phonePlaceholder: "(+84) 000-000-000",
    target: "Child's Name & Age",
    targetPlaceholder: "Example: John Jr. - 8 years old",
    interest: "Course of Interest",
    interestPlaceholder: "Example: Scratch coding",
    message: "Message",
    messagePlaceholder: "Please share what you'd like your child to achieve...",
    submit: "Register Now"
  }
};

const lf = labels[lang as 'vi' | 'en'] || labels.vi;
---

<section class="py-20 bg-surface" id="register">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 flex flex-col md:flex-row gap-16">
    <!-- Contact Info -->
    <div class="flex-1 space-y-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-onSurface">{data.title[lang]}</h2>
        <p class="text-onSurfaceVariant leading-relaxed">{data.description[lang]}</p>
      </div>
      <ul class="space-y-6 text-sm text-onSurfaceVariant">
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-lg">location_on</span>
          </div>
          <span class="mt-2.5 leading-relaxed">{data.address[lang]}</span>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-lg">mail</span>
          </div>
          <a href={`mailto:${data.email[lang]}`} class="mt-2.5 hover:text-primary transition-colors">{data.email[lang]}</a>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-lg">call</span>
          </div>
          <a href={`tel:${data.phone[lang]}`} class="mt-2.5 hover:text-primary transition-colors">{data.phone[lang]}</a>
        </li>
      </ul>
    </div>
    
    <!-- Form Card -->
    <div class="flex-1">
      <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm relative hover:shadow-md transition-shadow">
        <form action="#" class="space-y-5" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-onSurface mb-2 uppercase tracking-wider" for="name">{lf.fullName}</label>
              <input class="w-full border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm py-3 px-4 outline-none transition-all" id="name" name="name" placeholder={lf.fullNamePlaceholder} type="text" required/>
            </div>
            <div>
              <label class="block text-xs font-bold text-onSurface mb-2 uppercase tracking-wider" for="phone">{lf.phone}</label>
              <input class="w-full border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm py-3 px-4 outline-none transition-all" id="phone" name="phone" placeholder={lf.phonePlaceholder} type="tel" required/>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-onSurface mb-2 uppercase tracking-wider" for="target">{lf.target}</label>
            <input class="w-full border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm py-3 px-4 outline-none transition-all" id="target" name="target" placeholder={lf.targetPlaceholder} type="text" required/>
          </div>
          <div>
            <label class="block text-xs font-bold text-onSurface mb-2 uppercase tracking-wider" for="interest">{lf.interest}</label>
            <input class="w-full border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm py-3 px-4 outline-none transition-all" id="interest" name="interest" placeholder={lf.interestPlaceholder} type="text"/>
          </div>
          <div>
            <label class="block text-xs font-bold text-onSurface mb-2 uppercase tracking-wider" for="message">{lf.message}</label>
            <textarea class="w-full border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm py-3 px-4 outline-none transition-all resize-none" id="message" name="message" placeholder={lf.messagePlaceholder} rows="4"></textarea>
          </div>
          <div class="pt-2">
            <button class="w-full bg-secondary hover:bg-indigo-700 text-white font-bold py-3.5 px-8 rounded-full transition-all duration-300 shadow-sm hover:shadow-lg flex items-center justify-center gap-2 text-sm md:text-base cursor-pointer" type="submit">
              <span class="material-symbols-outlined text-lg">send</span>
              {lf.submit}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
