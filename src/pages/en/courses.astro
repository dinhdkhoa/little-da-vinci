---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';
import coursesData from '../../content/courses.json';

const lang = getLangFromUrl(Astro.url) as 'vi' | 'en';
const hero = coursesData.hero;
const courses = coursesData.courses;
---

<Layout title={`${hero.title[lang]} | Little Da Vinci`}>
  <section class="relative overflow-hidden bg-gradient-to-br from-secondary via-indigo-600 to-indigo-900 text-white py-24 md:py-32">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 left-10 w-72 h-72 bg-primary rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-indigo-300 rounded-full blur-3xl animate-pulse delay-1000"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 relative z-10 text-center">
      <span class="inline-block bg-white/10 backdrop-blur-sm text-primary font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-full mb-6 border border-white/20">
        <span class="material-symbols-outlined text-sm align-middle mr-1">auto_awesome</span>
        {lang === 'vi' ? '6 Chương Trình Học' : '6 Programs Available'}
      </span>
      <h1 class="text-4xl md:text-6xl font-black leading-tight mb-4">{hero.title[lang]}</h1>
      <p class="text-lg md:text-xl text-indigo-100 max-w-2xl mx-auto leading-relaxed">{hero.subtitle[lang]}</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80 Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="grid gap-8">
        {courses.map((course, index) => (
          <div class={`group relative bg-surface rounded-3xl overflow-hidden border border-gray-100 hover:border-primary/30 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/5`}>
            <div class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-0`}>
              <div class="md:w-5/12 relative overflow-hidden">
                <div class="aspect-[4/3] md:aspect-auto md:h-full">
                  <img src={course.image.secure_url} alt={course.title[lang]} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                </div>
                <div class="absolute top-4 left-4 flex gap-2">
                  <span class={`inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold shadow-lg ${course.color === 'primary' ? 'bg-primary text-white' : 'bg-secondary text-white'}`}>
                    <span class="material-symbols-outlined text-sm">{course.icon}</span>
                    {course.ageRange[lang]}
                  </span>
                </div>
              </div>
              <div class="md:w-7/12 p-8 md:p-10 lg:p-12 flex flex-col justify-center">
                <div class="flex flex-wrap gap-2 mb-4">
                  {course.tags.map((tag: { en: string; vi: string }) => (
                    <span class="text-xs font-semibold text-onSurfaceVariant bg-gray-100 px-3 py-1 rounded-full">{tag[lang]}</span>
                  ))}
                </div>
                <h2 class="text-2xl md:text-3xl font-black text-onSurface mb-3 group-hover:text-primary transition-colors duration-300">{course.title[lang]}</h2>
                <p class="text-onSurfaceVariant leading-relaxed text-base mb-6">{course.description[lang]}</p>
                <div class="flex items-center gap-3">
                  <a href="#register" class={`inline-flex items-center gap-2 font-bold text-sm px-6 py-3 rounded-full transition-all duration-300 shadow-sm hover:shadow-md ${course.color === 'primary' ? 'bg-primary hover:bg-green-500 text-white' : 'bg-secondary hover:bg-indigo-700 text-white'}`}>
                    {lang === 'vi' ? 'Đăng Ký Ngay' : 'Enrol Now'}
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </a>
                  <a href="#" class="inline-flex items-center gap-1 text-sm font-semibold text-onSurfaceVariant hover:text-primary transition-colors">
                    {lang === 'vi' ? 'Tìm hiểu thêm' : 'Learn more'}
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-r from-primary/10 via-secondary/5 to-primary/10">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-onSurface mb-4">
        {lang === 'vi' ? 'Chưa biết chọn khóa nào?' : 'Not sure which course to pick?'}
      </h2>
      <p class="text-onSurfaceVariant text-lg mb-8 max-w-2xl mx-auto">
        {lang === 'vi' ? 'Đặt lịch tư vấn miễn phí với đội ngũ giáo viên.' : 'Book a free consultation with our team — we\'ll recommend the perfect course for your child.'}
      </p>
      <a href="/en/contact" class="inline-flex items-center gap-2 bg-secondary hover:bg-indigo-700 text-white font-bold px-8 py-4 rounded-full transition-all shadow-lg hover:shadow-xl text-base">
        <span class="material-symbols-outlined">call</span>
        {lang === 'vi' ? 'Tư Vấn Miễn Phí' : 'Free Consultation'}
      </a>
    </div>
  </section>
</Layout>
