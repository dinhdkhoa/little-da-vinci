---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hompage/Hero.astro';
import HowWeTeach from '../components/hompage/HowWeTeach.astro';
import Programs from '../components/hompage/Programs.astro';
import Gallery from '../components/hompage/Gallery.astro';
import Testimonials from '../components/hompage/Testimonials.astro';
import Partners from '../components/hompage/Partners.astro';
import CTA from '../components/hompage/CTA.astro';
import homeData from '../content/home.json';

const lang = Astro.currentLocale ?? "vi";
---

<Layout title="Little Da Vinci - Tech Academy">
    <Hero data={homeData.hero} lang={lang} />
    <HowWeTeach data={homeData.howWeTeach} lang={lang} />
    <Programs data={homeData.programs} lang={lang} />
    <Gallery data={homeData.gallery} lang={lang} />
    <Testimonials data={homeData.testimonials} lang={lang} />
    <Partners />
    <CTA data={homeData.cta} lang={lang} />
</Layout>

