---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';
import eventsData from '../content/events.json';

const lang = getLangFromUrl(Astro.url) as 'vi' | 'en';
const hero = eventsData.hero;
const upcoming = eventsData.upcoming;
const filters = eventsData.filters;

const tagColors: Record<string, { bg: string; text: string }> = {
  live: { bg: 'bg-green-100', text: 'text-green-700' },
  new: { bg: 'bg-indigo-100', text: 'text-indigo-700' },
  filling: { bg: 'bg-amber-100', text: 'text-amber-700' },
  free: { bg: 'bg-primary/15', text: 'text-primary' },
};

const tagLabels: Record<string, Record<string, string>> = {
  live: { en: 'Enrolling', vi: 'Đang chiêu sinh' },
  new: { en: 'New', vi: 'Mới' },
  filling: { en: 'Filling Fast', vi: 'Sắp đầy' },
  free: { en: 'Free', vi: 'Miễn phí' },
};

function formatDate(dateStr: string, locale: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-US', { month: 'short', day: 'numeric' });
}
---

<Layout title={`${hero.title[lang]} | Little Da Vinci`}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary via-emerald-500 to-teal-600 text-white py-24 md:py-32">
    <div class="absolute inset-0 opacity-15">
      <div class="absolute top-10 right-20 w-80 h-80 bg-white rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-10 left-10 w-64 h-64 bg-yellow-300 rounded-full blur-3xl animate-pulse"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 relative z-10 text-center">
      <span class="inline-block bg-white/15 backdrop-blur-sm font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-full mb-6 border border-white/20">
        <span class="material-symbols-outlined text-sm align-middle mr-1">celebration</span>
        {lang === 'vi' ? `${upcoming.length} Sự Kiện Sắp Tới` : `${upcoming.length} Upcoming Events`}
      </span>
      <h1 class="text-4xl md:text-6xl font-black leading-tight mb-4">{hero.title[lang]}</h1>
      <p class="text-lg md:text-xl text-green-50 max-w-2xl mx-auto leading-relaxed">{hero.subtitle[lang]}</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80 Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Events Timeline -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <h2 class="text-3xl md:text-4xl font-black text-onSurface mb-2">
            {lang === 'vi' ? 'Sắp Diễn Ra' : 'Coming Up'}
          </h2>
          <p class="text-onSurfaceVariant">
            {lang === 'vi' ? 'Đăng ký sớm để giữ chỗ cho bé!' : 'Register early to secure your child\'s spot!'}
          </p>
        </div>
      </div>

      <!-- Events Cards -->
      <div class="grid gap-6">
        {upcoming.map((event, i) => {
          const tc = tagColors[event.tag] || tagColors.live;
          const tl = tagLabels[event.tag] || tagLabels.live;
          return (
            <div class="group relative bg-surface rounded-3xl overflow-hidden border border-gray-100 hover:border-primary/30 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/5">
              <div class="flex flex-col md:flex-row">
                <!-- Date Column -->
                <div class="md:w-32 lg:w-40 flex-shrink-0 bg-gradient-to-b from-gray-900 to-gray-800 text-white flex flex-col items-center justify-center p-6 md:p-8 text-center">
                  <span class="text-3xl md:text-4xl font-black leading-none">{new Date(event.date).getDate()}</span>
                  <span class="text-sm font-bold uppercase tracking-wider text-gray-300 mt-1">
                    {new Date(event.date).toLocaleDateString(lang === 'vi' ? 'vi-VN' : 'en-US', { month: 'short' })}
                  </span>
                  <span class="text-xs text-gray-500 mt-1">{new Date(event.date).getFullYear()}</span>
                </div>

                <!-- Image -->
                <div class="md:w-64 lg:w-80 flex-shrink-0 relative overflow-hidden">
                  <img
                    src={event.image.secure_url}
                    alt={event.title[lang]}
                    class="w-full h-48 md:h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                </div>

                <!-- Content -->
                <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span class={`text-xs font-bold px-3 py-1 rounded-full ${tc.bg} ${tc.text}`}>{tl[lang]}</span>
                    <span class="text-xs font-semibold text-onSurfaceVariant bg-gray-100 px-3 py-1 rounded-full">{event.type[lang]}</span>
                  </div>
                  <h3 class="text-xl md:text-2xl font-black text-onSurface mb-2 group-hover:text-primary transition-colors duration-300">
                    {event.title[lang]}
                  </h3>
                  <p class="text-sm text-onSurfaceVariant leading-relaxed mb-4">{event.description[lang]}</p>
                  <div class="flex flex-wrap items-center gap-4 text-xs text-onSurfaceVariant">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-sm text-primary">location_on</span>
                      {event.location[lang]}
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-sm text-primary">calendar_today</span>
                      {formatDate(event.date, lang)} — {formatDate(event.endDate, lang)}
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-sm text-primary">group</span>
                      {event.spots} {lang === 'vi' ? 'chỗ còn' : 'spots left'}
                    </span>
                  </div>
                  <div class="mt-5">
                    <a href="#register" class="inline-flex items-center gap-2 bg-primary hover:bg-green-500 text-white font-bold text-sm px-6 py-3 rounded-full transition-all shadow-sm hover:shadow-md">
                      {lang === 'vi' ? 'Đăng Ký' : 'Register'}
                      <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 bg-gradient-to-r from-primary/10 via-teal-50 to-primary/10">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="material-symbols-outlined text-5xl text-primary mb-4">notifications_active</span>
      <h2 class="text-3xl md:text-4xl font-black text-onSurface mb-4">
        {lang === 'vi' ? 'Không bỏ lỡ sự kiện nào!' : 'Never miss an event!'}
      </h2>
      <p class="text-onSurfaceVariant text-lg mb-8 max-w-2xl mx-auto">
        {lang === 'vi'
          ? 'Theo dõi fanpage hoặc liên hệ để nhận thông báo về các sự kiện và khóa học mới nhất.'
          : 'Follow our page or get in touch to receive updates about the latest events and courses.'}
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-secondary hover:bg-indigo-700 text-white font-bold px-8 py-4 rounded-full transition-all shadow-lg hover:shadow-xl text-base">
        <span class="material-symbols-outlined">mail</span>
        {lang === 'vi' ? 'Liên Hệ Ngay' : 'Contact Us'}
      </a>
    </div>
  </section>
</Layout>
