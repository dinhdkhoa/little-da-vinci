---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/utils';
import teamsData from '../content/teams.json';

const lang = getLangFromUrl(Astro.url) as 'vi' | 'en';
const hero = teamsData.hero;
const members = teamsData.members;
const values = teamsData.values;
---

<Layout title={`${hero.title[lang]} | Little Da Vinci`}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white py-24 md:py-32">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-20 left-1/4 w-64 h-64 bg-primary rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-20 right-1/4 w-80 h-80 bg-secondary rounded-full blur-3xl animate-pulse"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24 relative z-10 text-center">
      <span class="inline-block bg-white/10 backdrop-blur-sm text-primary font-bold text-xs uppercase tracking-widest px-4 py-2 rounded-full mb-6 border border-white/20">
        <span class="material-symbols-outlined text-sm align-middle mr-1">groups</span>
        {lang === 'vi' ? 'Đội Ngũ' : 'Our People'}
      </span>
      <h1 class="text-4xl md:text-6xl font-black leading-tight mb-4">{hero.title[lang]}</h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">{hero.subtitle[lang]}</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80 Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Team Grid -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {members.map((member, i) => (
          <div class="group relative bg-surface rounded-3xl overflow-hidden border border-gray-100 hover:border-primary/30 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/5 hover:-translate-y-1">
            <!-- Member Photo -->
            <div class="relative overflow-hidden aspect-[4/3]">
              <img
                src={member.image.secure_url}
                alt={member.name[lang]}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <!-- Tags overlay -->
              <div class="absolute bottom-4 left-4 flex flex-wrap gap-1.5">
                {member.tags.map((tag) => (
                  <span class="text-[10px] font-bold uppercase tracking-wide bg-white/20 backdrop-blur-sm text-white px-2.5 py-1 rounded-full border border-white/10">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Member Info -->
            <div class="p-6">
              <h3 class="text-lg font-black text-onSurface group-hover:text-primary transition-colors duration-300">{member.name[lang]}</h3>
              <p class={`text-sm font-bold mb-3 ${i % 2 === 0 ? 'text-primary' : 'text-secondary'}`}>{member.role[lang]}</p>
              <p class="text-sm text-onSurfaceVariant leading-relaxed">{member.bio[lang]}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 md:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-onSurface mb-4">
          {lang === 'vi' ? 'Giá Trị Cốt Lõi' : 'Our Core Values'}
        </h2>
        <p class="text-onSurfaceVariant max-w-xl mx-auto">
          {lang === 'vi'
            ? 'Những nguyên tắc định hướng mọi hoạt động giảng dạy của chúng tôi.'
            : 'The principles that guide everything we teach.'}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value, i) => (
          <div class="group bg-white rounded-2xl p-8 border border-gray-100 hover:border-primary/30 transition-all duration-500 hover:shadow-xl text-center">
            <div class={`inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-6 transition-all duration-300 group-hover:scale-110 ${i === 0 ? 'bg-primary/10 text-primary' : i === 1 ? 'bg-secondary/10 text-secondary' : 'bg-amber-50 text-amber-500'}`}>
              <span class="material-symbols-outlined text-3xl">{value.icon}</span>
            </div>
            <h3 class="text-lg font-black text-onSurface mb-3">{value.title[lang]}</h3>
            <p class="text-sm text-onSurfaceVariant leading-relaxed">{value.description[lang]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="py-16 bg-gradient-to-r from-gray-900 to-gray-800 text-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-black mb-4">
        {lang === 'vi' ? 'Muốn gia nhập đội ngũ?' : 'Want to join our team?'}
      </h2>
      <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
        {lang === 'vi'
          ? 'Chúng tôi luôn tìm kiếm những nhà giáo dục đam mê truyền cảm hứng cho thế hệ tiếp theo.'
          : 'We\'re always looking for passionate educators who inspire the next generation.'}
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-primary hover:bg-green-500 text-white font-bold px-8 py-4 rounded-full transition-all shadow-lg hover:shadow-xl text-base">
        <span class="material-symbols-outlined">mail</span>
        {lang === 'vi' ? 'Liên Hệ Ngay' : 'Get In Touch'}
      </a>
    </div>
  </section>
</Layout>
